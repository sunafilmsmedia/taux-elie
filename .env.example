# --- Externes (tous optionnels : l'app fonctionne en mode stub sans eux) ---

# Anthropic (Claude) — utilisé côté serveur pour :
#  1. générer la réponse IA personnalisée (src/lib/ai.ts)
#  2. aller chercher les taux hypothécaires actuels via l'outil de recherche
#     web de Claude, mis en cache 12h côté serveur (src/lib/rates.ts)
# Tant que la clé n'est pas branchée, les deux retombent sur un mode local
# (texte générique / pas de chiffre de taux affiché).
ANTHROPIC_API_KEY=
# Optionnel : modèle (défaut: claude-opus-5-5).
ANTHROPIC_MODEL=

# CRM (GoHighLevel) — webhook entrant qui reçoit le lead. Utiliser le MÊME
# webhook que consolidation-ia (même courtier, Elie). Si vide, src/lib/crm.ts
# logue le payload côté serveur au lieu de l'envoyer.
CRM_WEBHOOK_URL=
